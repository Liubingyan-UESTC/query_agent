# Query Agent 环境变量样例
# 用法：复制为 .env 后按需填写（.env 已被 .gitignore 忽略，切勿提交真实密钥）
# 命名规范：<组前缀>_<字段名>，全大写下划线分隔；布尔值 true/false；列表用 JSON 数组。
#
# 全部键都是可选的：一个键都不填也能跑——未配置 LLM_API_KEY 时自动回落到 MockLLM。

# ========================= 应用 =========================
APP_ENV=dev                       # dev | test | prod
APP_DEBUG=true

# ========================= 日志 =========================
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_DIR=logs                      # 相对项目根；不存在时自动创建
LOG_FILE=log.txt
LOG_MAX_BYTES=2097152             # 单文件上限 2MiB，超出即轮转
LOG_BACKUP_COUNT=5                # 保留几个历史文件
LOG_TO_CONSOLE=true               # 是否同时输出到控制台（stderr）

# ========================= LLM 主模型 =========================
LLM_API_KEY=                      # 【私密】留空则自动使用 MockLLM
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2                 # 单个端点内的重试次数（指数退避）
LLM_MAX_CONCURRENCY=8             # 全进程同时在途的模型调用数上限
                                  #
                                  # 注意：并发单位是"单次 LLM HTTP 调用"，不是"完整任务"。
                                  # 每个 Agent 任务内部要做 4 次串行的 LLM 调用
                                  # (intent → plan → execute → validate)，所以 MAX=8
                                  # 等价于同时推进约 2 个完整任务（8 ÷ 4）。
                                  #
                                  # 实测：MiniMax Token Plan 下，MAX=8 可稳定撑住 32 个并发会话
                                  # （实测 0 失败）；N=64 时偶发 1 个 HTTP 529（集群负载过载），
                                  # 不是账户级 429。设更小只增加等待时间，并不减少失败。
                                  #
                                  # 与 HTTP 层 gunicorn 线程数无关——线程大部分时间在等网络，
                                  # 多开没事；这里才是真瓶颈。
                                  #
                                  # 调优流程：① 查供应商控制台拿到并发/RPM 配额；
                                  # ② 起步设成配额 × 0.7；③ 跑 1 分钟梯度负载，看 429 比例；
                                  # ④ 有 429 就降一档，否则不动。
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# 强制使用 MockLLM（即使配了 key）
LLM_USE_MOCK=false

# 降级模型链（JSON 数组，元素结构同主模型；主模型不可用时按顺序尝试）
# 例：[{"name":"backup","base_url":"https://x/v1","api_key":"sk-xxx","model":"m2"}]
LLM_FALLBACKS=[]

# ========================= 上下文窗口 =========================
CONTEXT_HISTORY_SUMMARY_LIMIT=10  # 意图识别投喂的历史 task summary 条数
CONTEXT_RELATED_CONTENT_LIMIT=6   # 单个关联任务注入的历史消息条数
CONTEXT_RECENT_CONTENT_LIMIT=12   # 执行阶段保留的近 K 条本任务消息

# ========================= 记忆 =========================
MEMORY_MAX_TASKS=20               # WorkingMemory 保留的历史任务数

# ========================= 工具与数据源 =========================
TOOL_DATA_FILE=data/logs.json     # 假数据库（Kibana 风格日志），相对项目根
TOOL_MAX_ROWS=200                 # 单次检索返回的最大记录数
TOOL_PREVIEW_MAX_ROWS=3           # 回给模型的预览最多几条
TOOL_PREVIEW_MAX_CHARS=600        # 预览字符上限

# ========================= 任务护栏 =========================
TASK_MAX_STEPS=8                  # 规划允许的最大步骤数
TASK_MAX_TOOL_CALLS=16            # 单任务工具调用总次数
TASK_MAX_ROUNDS_PER_STEP=4        # 单步内"模型↔工具"往返轮数
TASK_MAX_REVALIDATE=2             # 校验不通过后回到执行阶段的次数
TASK_MAX_RETRY=3                  # 任务级重试次数（429 等可重试错误）
                                   # base=5, max=3 时退避序列：5s/10s/20s，
                                   # 跨过 MiniMax Token Plan 的 429 窗口
TASK_RETRY_BACKOFF_SECONDS=5.0    # 任务级重试的退避基数（第 n 次等 base*2^(n-1) 秒）
TASK_RETRY_BACKOFF_CAP_SECONDS=60 # 单次退避上限（防 attempt 过大时 sleep 几小时）
