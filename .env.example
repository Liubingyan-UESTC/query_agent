# Query Agent 环境变量样例
# 用法：复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，切勿提交真实密钥）
# 命名规范：<模块前缀>_<字段名>，全大写下划线分隔；布尔值用 true/false；列表用 JSON 数组。

# ========================= 应用 =========================
APP_ENV=dev                       # dev | test | prod
APP_DEBUG=true
APP_LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
APP_SECRET_KEY=                   # Django SECRET_KEY，prod 必填
APP_ALLOWED_HOSTS=["*"]
APP_CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# ========================= LLM 主模型 =========================
LLM_PRIMARY_NAME=primary
LLM_PRIMARY_BASE_URL=https://api.openai.com/v1
LLM_PRIMARY_API_KEY=              # 必填
LLM_PRIMARY_MODEL=gpt-4o-mini
LLM_PRIMARY_TIMEOUT=60
LLM_PRIMARY_MAX_RETRIES=2
LLM_PRIMARY_TEMPERATURE=0.0
LLM_PRIMARY_MAX_TOKENS=4096

# 降级模型列表（JSON 数组，元素结构同上；主模型不可用时按顺序尝试）
# 例：[{"name":"backup","base_url":"https://x/v1","api_key":"sk-xxx","model":"m2"}]
LLM_FALLBACKS=[]

# 按用途路由模型名，留空则回落到主模型
LLM_INTENT_MODEL=
LLM_PLAN_MODEL=
LLM_EXECUTE_MODEL=

# 是否使用 Mock LLM（本地无密钥时跑通全链路）
LLM_USE_MOCK=false

# ========================= 上下文窗口 =========================
CONTEXT_MAX_TOTAL_TOKENS=32000
CONTEXT_SUMMARY_BUDGET_RATIO=0.15
CONTEXT_CONTENT_BUDGET_RATIO=0.65
CONTEXT_ARTIFACT_BUDGET_RATIO=0.20
CONTEXT_HISTORY_SUMMARY_LIMIT=10      # 意图识别投喂的历史 task_summary 条数
CONTEXT_RELATED_TASK_CONTENT_LIMIT=6  # 单个关联任务注入的 content 条数上限
CONTEXT_RECENT_CONTENT_LIMIT=8        # 执行阶段保留的近 K 轮对话
CONTEXT_CONTENT_DIGEST_CHARS=400      # 规划 / 校验阶段单条 content 摘要字符上限

# ========================= 记忆 =========================
MEMORY_SESSION_TTL=3600               # 秒
MEMORY_WORKING_MEMORY_MAX_TASKS=20

# ========================= 工具 =========================
TOOL_DEFAULT_TIMEOUT=30
TOOL_MAX_RESULT_ROWS=1000
TOOL_MAX_RETRY=2
TOOL_EXPORT_DIR=data/exports          # ExportTool 落盘目录
TOOL_USE_MOCK=false                   # true 时只实例化 is_mock 工具

# ========================= 任务护栏 =========================
TASK_MAX_STEPS=10
TASK_MAX_TOOL_CALLS=20
TASK_MAX_REPLAN=2
TASK_MAX_DURATION_SECONDS=300
TASK_INTENT_MIN_CONFIDENCE=0.4        # 低于此置信度降级为 CHAT
TASK_ARCHIVE_FAILED_CONTENT=false     # FAILED/CANCELED 默认只归档 summary

# ========================= 存储 =========================
STORE_BACKEND=memory                  # memory | redis
STORE_REDIS_URL=redis://localhost:6379/0

# ========================= Elasticsearch / Kibana =========================
ES_HOSTS=["http://localhost:9200"]
ES_USERNAME=
ES_PASSWORD=
ES_DEFAULT_INDEX=
ES_VERIFY_CERTS=false

# ========================= 可观测性 =========================
TRACE_ENABLED=false
TRACE_DIR=logs/traces
